{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    // Examples import the package by name, as users do; typecheck them against the source, not a build.
    "paths": {
      "pii-allowlist": ["./src/index.ts"],
      "pii-allowlist/*": ["./src/adapters/*.ts"]
    },
    "resolveJsonModule": true,
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "esModuleInterop": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true
  },
  "include": ["src", "test", "examples", "*.config.ts"]
}
